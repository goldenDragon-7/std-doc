  "root": {
    "summary": "~34 quantitative charts, on tap, zero-dep, freeze-clean. Every card below is authored with nothing but a dtype \u2014 no pasted SVG, no Node toolchain, no CDN. std-doc looks the name up in the Flint catalog (stddoc-lib/flint/*.svg) and embeds the pre-baked, freeze-clean chart inline. Pick a group above to browse its charts; each page shows the LIVE render immediately followed by its copy-paste source.",
    "facets": {
      "Comparison": "bar chart, grouped bar chart, stacked bar chart, lollipop chart, bullet chart, waterfall chart, gantt chart, radar chart",
      "Distribution": "boxplot, violin plot, histogram, density plot, ECDF plot, strip plot, pyramid chart, candlestick chart",
      "Trend & Time": "line chart, area chart, range area chart, sparkline, bump chart, slope chart, streamgraph",
      "Part-to-whole": "pie chart, rose chart",
      "Correlation": "scatter plot, connected scatter plot, regression, ranged dot plot, heatmap",
      "Geo": "map, choropleth",
      "KPI & Tables": "KPI card, bar table"
    }
  },
