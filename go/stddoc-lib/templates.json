    "<span class='acb-status'></span>",
    "</div>",
    "<script>",
    "(function(){var s=document.currentScript;if(!s)return;var r=s.parentElement;var btn=r.querySelector('.acb-run'),rst=r.querySelector('.acb-reset'),sta=r.querySelector('.acb-status');var stages=Array.from(r.querySelectorAll('.acb-stage'));var idle=r.getAttribute('data-idle')||'IDLE';var done=r.getAttribute('data-done')||'COMPLETED ✓';var timers=[];function dot(){return \"<span class='acb-dot'></span>\";}function setS(cls,html){sta.className='acb-status '+cls;sta.innerHTML=html;}function clear(){stages.forEach(function(e){e.classList.remove('acb-lit','acb-done');});}function finish(){stages.forEach(function(e){e.classList.remove('acb-lit');e.classList.add('acb-done');});setS('done',dot()+done);btn.disabled=false;if(rst)rst.disabled=false;}function run(){clear();btn.disabled=true;if(rst)rst.disabled=true;setS('running',dot()+'WORKING…');timers.forEach(clearTimeout);timers=[];if(!stages.length){timers.push(setTimeout(finish,800));return;}stages.forEach(function(e,i){timers.push(setTimeout(function(){stages.forEach(function(p,j){p.classList.remove('acb-lit');if(j<i)p.classList.add('acb-done');});e.classList.add('acb-lit');var det=e.getAttribute('data-detail')||'';setS('running',dot()+'WORKING…'+(det?' — '+det:''));if(i===stages.length-1){timers.push(setTimeout(finish,650));}},700*(i+1)));});}btn.addEventListener('click',run);if(rst)rst.addEventListener('click',function(){timers.forEach(clearTimeout);timers=[];clear();setS('idle',dot()+idle);rst.disabled=true;btn.disabled=false;});setS('idle',dot()+idle);})();",
    "</script>",
    "</div>"
