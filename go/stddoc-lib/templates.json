    "<script>",
    "(function(){var s=document.currentScript;if(!s)return;var r=s.parentElement;var tabs=r.querySelectorAll('.sab-tab'),worlds=r.querySelectorAll('.sab-world'),line=r.querySelector('.sab-line');function act(v){tabs.forEach(function(t){var on=t.getAttribute('data-voice')===v;t.setAttribute('aria-selected',on?'true':'false');if(on&&line)line.textContent=t.getAttribute('data-line')||'';});worlds.forEach(function(w){w.classList.toggle('sab-on',w.getAttribute('data-voice')===v);});}tabs.forEach(function(t){t.addEventListener('click',function(){var v=t.getAttribute('data-voice');act(v);try{localStorage.setItem('stddoc-style',v);}catch(e){}});});var stored=null;try{stored=localStorage.getItem('stddoc-style');}catch(e){}var has=false;worlds.forEach(function(w){if(w.getAttribute('data-voice')===stored)has=true;});var def=r.getAttribute('data-default')||(worlds[0]&&worlds[0].getAttribute('data-voice'))||'';act(has?stored:def);})();",
